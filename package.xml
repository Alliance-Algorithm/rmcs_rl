<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rmcs_rl</name>
  <version>0.1.0</version>
  <description>RMCS RL policy bridge with in-process ONNX Runtime CPU inference</description>
  <maintainer email="alliance@njust.edu.cn">alliance</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>pluginlib</depend>
  <depend>ament_index_cpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>rmcs_executor</depend>
  <depend>rmcs_description</depend>
  <depend>rmcs_msgs</depend>
  <depend>rmcs_utility</depend>
  <depend>nlohmann_json</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
